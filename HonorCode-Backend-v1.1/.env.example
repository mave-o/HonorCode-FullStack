# .env.example
# Template for the BACKEND's settings. Committed to git with placeholders only.
# Local use:  copy this file to ".env" and fill it in.
# Vercel:     add the same names under Project Settings > Environment Variables
#             (mark GOOGLE_PRIVATE_KEY and JWT_SECRET as Sensitive).
# The real .env is ignored by git. NEVER commit it, paste it in chat, or put these values in the extension.

# --- Storage -----------------------------------------------------------------
# "sheets" = real Google Sheet (use this on Vercel).
# "memory" = throwaway local storage for trying the API without Google (blocked in production).
STORAGE_MODE=sheets

# The long ID in the sheet's address: docs.google.com/spreadsheets/d/<THIS PART>/edit
GOOGLE_SHEET_ID=your-sheet-id-here

# From the service account's JSON key file: the "client_email" field.
# Share the sheet with this address as Editor.
GOOGLE_SERVICE_ACCOUNT_EMAIL=honorcode@your-project.iam.gserviceaccount.com

# From the same JSON file: the "private_key" field. Keep the \n characters, wrap in double quotes.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nPASTE-KEY-HERE\n-----END PRIVATE KEY-----\n"

# --- Login security ----------------------------------------------------------
# At least 32 random characters. Signs login tokens and session ids.
# Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing it later logs everyone out.
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars

# How long a login lasts. Keep it above the extension's MAX_SESSION_HOURS (6) so a quiz
# is not cut off by an expired token. (Optional, default 8, allowed 1-72)
JWT_EXPIRY_HOURS=8

# bcrypt work factor for password hashing. (Optional, default 10, allowed 8-14)
BCRYPT_COST=10

# --- Course ------------------------------------------------------------------
# The code students must enter to register. Share it with your class only.
COURSE_CODE=change-me

# Stored in the accounts sheet next to each student. (Optional)
COURSE_NAME=course-1

# --- Browser access (optional) -----------------------------------------------
# Comma-separated origins allowed to call the API from a browser page. The extension itself does not need this
# (it uses host_permissions), but it is useful for testing tools. Example:
# ALLOWED_ORIGINS=chrome-extension://abcdefghijklmnopabcdefghijklmnop
ALLOWED_ORIGINS=
