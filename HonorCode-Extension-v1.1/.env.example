# .env.example
# Template for the extension's settings. Committed to git with SAFE values only.
# Setup: copy this file to ".env", edit the values, then run:  node scripts/build-env.js
#
# WARNING: everything in this file ends up inside the extension, and anyone can
# unzip an extension and read it. NEVER put passwords, API keys, JWT secrets or the
# Google service account key here. Those belong in the BACKEND's own .env.

# --- Required ---------------------------------------------------------------

# Where the backend runs. No trailing slash. Must be https:// unless it is localhost.
# The build script also writes this origin into manifest.json -> host_permissions.
API_BASE_URL=http://localhost:3000

# --- Optional (the defaults below are used if a line is removed) -------------

# A tab only counts as the quiz if its address starts with this.
QUIZ_URL_PREFIX=https://docs.google.com/forms/

# DEV ONLY. true = tracking can start on any page (no real Google Form needed).
# Must be false in any build students use.
ALLOW_ANY_PAGE_AS_QUIZ=false

# false = no Stop button; tracking ends only when the form is submitted.
ALLOW_MANUAL_STOP=true

# Send a batch as soon as this many events are waiting.
BATCH_SIZE=20

# Also send if this many milliseconds passed since the last upload.
FLUSH_INTERVAL_MS=15000

# Give up on a hung request after this many milliseconds.
REQUEST_TIMEOUT_MS=10000

# Minutes between "still alive" heartbeats (Chrome's minimum is 0.5).
HEARTBEAT_MINUTES=0.5

# A session left running longer than this many hours is stopped automatically.
MAX_SESSION_HOURS=6
